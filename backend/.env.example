# Server
NODE_ENV=development
PORT=8080
TRUST_PROXY=1
ALLOWED_ORIGINS=*

# Firebase & Firestore
FIREBASE_PROJECT_ID=gen-lang-client-0779493844
FIRESTORE_DATABASE_ID=ai-studio-android-cobradas-7d14e11d-d08c-4f3a-a51f-0889d495ef61
# Provide either GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# OR raw JSON / base64 JSON in FIREBASE_SERVICE_ACCOUNT_JSON (keep secret on server only!)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Multiplayer Simulation & Room Settings
MAX_PLAYERS_PER_MATCH=16
DEFAULT_MAX_PLAYERS=12
TICK_RATE_HZ=30
SNAPSHOT_RATE_HZ=20
RECONNECT_GRACE_MS=15000
IDLE_ROOM_TTL_MS=300000
INPUT_RATE_LIMIT_PER_SEC=45

# Google Play Billing Server-Side Verification
ANDROID_PACKAGE_NAME=com.aistudio.cobradash3d.xkwmqt
# Optional: set to service account JSON if different from Firebase ADC for Play AndroidPublisher API
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Admin API Access (comma-separated Firebase UIDs and/or strong server-only secret key)
ADMIN_UIDS=
ADMIN_API_KEY=change-me-to-a-long-random-secret
